---
import type { ImageMetadata } from "astro";
import Image from "astro/components/Image.astro";

interface Props {
  images: ImageMetadata[];
  title: string;
  description: string;
}

const { images, title, description } = Astro.props as Props;
const imageAspectRatio =
  images.length > 0 ? `${images[0].width} / ${images[0].height}` : "16 / 9";
---

<div class="relative card-character">
  <div
    class="relative z-1 bg-character w-full overflow-hidden bg-black"
    style={`aspect-ratio: ${imageAspectRatio};`}
  >
    {
      images.map((img, index) => (
        <Image
          src={img}
          alt={`fondo personaje ${title.toLowerCase()}`}
          class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${index === 0 ? "opacity-100" : "opacity-0"}`}
        />
      ))
    }
  </div>
  <div class="absolute right-30 top-35 z-2 w-80">
    <h4
      class="bg-red text-6xl font-[Teko] bg-custom mb-5"
      style={`--pattern-url: url('/images/common/site_pattern.png')`}
    >
      {title}
    </h4>
    <p class="text-white">
      {description}
    </p>
  </div>
  <div class="absolute left-5 bottom-2 z-2 text-white">
    <div class="flex items-center gap-2 text-sm font-[Teko]">
      <span>IMAGES</span>
      <div class="flex items-center gap-2">
        {
          images.map((_, index) => (
            <button
              type="button"
              class={`image-index-btn ${index === 0 ? "is-active" : ""}`}
              data-index={index}
              aria-label={`Show image ${index + 1}`}
            >
              {index + 1}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .bg-custom {
    background-image: var(--pattern-url);
    background-position: left top;
    background-size: 1000px;
    background-clip: text;
    -webkit-background-clip: text;
    color: rgba(187, 16, 32, 0);
    display: inline-block;
    position: relative;
    top: 0.06em;
    transform: scale(1, 1.2);
    filter: drop-shadow(5px 0 10px rgba(0, 0, 0, 0.8));
  }
  .image-index-btn {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid #9a9394;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    font-style: normal;
    line-height: 1;
    padding: 0;
  }

  .image-index-btn::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    --progress: 0deg;
    background: conic-gradient(
      from 0deg,
      #fff var(--progress),
      transparent 0deg
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 1px),
      #000 calc(100% - 1px)
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 1px),
      #000 calc(100% - 1px)
    );
    opacity: 0;
  }

  .image-index-btn.is-active::after {
    opacity: 1;
    animation: loading-ring 5s linear forwards;
  }

  @property --progress {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes loading-ring {
    from {
      --progress: 0deg;
    }
    to {
      --progress: 360deg;
    }
  }
</style>

<script>
  const sliders = document.querySelectorAll(".card-character .bg-character");

  sliders.forEach((slider) => {
    const card = slider.closest(".card-character");
    const imgCharacters = slider.querySelectorAll("img");
    const controls = card
      ? Array.from(card.querySelectorAll(".image-index-btn"))
      : [];

    if (imgCharacters.length === 0) return;

    let currentIndex = 0;
    let intervalId = 0;

    const updateSlide = () => {
      imgCharacters.forEach((img, imgIndex) => {
        img.classList.toggle("opacity-0", imgIndex !== currentIndex);
      });

      controls.forEach((control, controlIndex) => {
        if (!(control instanceof HTMLButtonElement)) return;
        control.classList.toggle("is-active", controlIndex === currentIndex);
      });
    };

    const goToNextSlide = () => {
      currentIndex = (currentIndex + 1) % imgCharacters.length;
      updateSlide();
    };

    const restartInterval = () => {
      if (intervalId) clearInterval(intervalId);

      const activeControl = controls[currentIndex];
      if (activeControl instanceof HTMLButtonElement) {
        activeControl.classList.remove("is-active");
        void activeControl.offsetWidth;
        activeControl.classList.add("is-active");
      }

      if (imgCharacters.length <= 1) return;

      intervalId = window.setInterval(goToNextSlide, 5000);
    };

    controls.forEach((control) => {
      if (!(control instanceof HTMLButtonElement)) return;

      control.addEventListener("click", () => {
        currentIndex = Number(control.dataset.index || "0");
        updateSlide();
        restartInterval();
      });
    });

    updateSlide();
    restartInterval();
  });
</script>
